APP_ENV=production
APP_DEBUG=false
APP_NAME="Your App"
APP_TIMEZONE=Europe/Prague

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_CHARSET=utf8mb4

# URLs - Production
BASE_URL=
SITE_URL=https://your-domain.com

# URLs - Development
BASE_URL_DEV=/your-project/public
SITE_URL_DEV=http://localhost/your-project

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_TIMEOUT=15
MAIL_FROM_ADDRESS=noreply@your-domain.com
MAIL_FROM_NAME=Your App
MAIL_TO_ADDRESS=contact@your-domain.com
MAIL_TO_NAME="Contact inbox"

# reCAPTCHA
RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# AI
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307

# Comgate
COMGATE_MERCHANT=
COMGATE_SECRET=
COMGATE_TEST=true
COMGATE_CURRENCY=CZK
COMGATE_LANG=cs
COMGATE_COUNTRY=CZ
COMGATE_RETURN_URL=https://your-domain.com/payment/comgate/return
COMGATE_NOTIFY_URL=https://your-domain.com/payment/comgate/notify

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.com/auth/google/callback

# Vouchers
VOUCHER_CODE_PREFIX=MIDO
