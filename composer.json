{
"autoload": {
  "files": [
    "src/helpers/csrf_helper.php",
    "src/helpers/config_helper.php"
  ],
  "psr-4": {
    "Controllers\\": "src/controllers/",
    "Models\\": "src/models/",
    "Core\\": "src/classes/core/",
    "Helpers\\": "src/helpers/",
    "Middleware\\": "src/middleware/",
    "Services\\": "src/services/",
    "Actions\\": "src/Actions/",
    "Dto\\": "src/Dto/",
    "Api\\": "src/Api/"
  }
  },
  "require": {
    "phpmailer/phpmailer": "^6.10",
    "smalot/pdfparser": "^2.0",
    "comgate/sdk": "^1.7",
    "dompdf/dompdf": "^3.1",
    "google/apiclient": "^2.19"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "platform": {
      "php": "8.4.99"
    }
  },
  "require-dev": {
    "pestphp/pest": "5.*",
    "phpstan/phpstan": "2.*",
    "friendsofphp/php-cs-fixer": "3.*"
  },
  "scripts": {
    "test": "pest",
    "test:smoke": "pest tests/Feature/SmokeSuitesTest.php",
    "lint": "@php tools/lint.php",
    "lint:style": "php-cs-fixer check --diff",
    "format": "php-cs-fixer fix",
    "analyse": "phpstan analyse --memory-limit=512M",
    "quality": [
      "@lint",
      "@lint:style",
      "@analyse",
      "@test"
    ]
  }
}
